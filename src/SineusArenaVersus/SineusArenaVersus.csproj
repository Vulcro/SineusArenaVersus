<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SineusArenaVersus</AssemblyName>
    <RootNamespace>SineusArenaVersus</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExProfile)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExProfile)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\SineusArena_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalog\catalog.json" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SineusArenaVersus.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Thunderstore: https://wiki.thunderstore.io/llms-and-ai-generated-files -->
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="This assembly was partially or fully created with the assistance of Generative AI (e.g., Code Suggestions, Refactoring, Documentation Generation)." />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Cursor/Composer" />
  </ItemGroup>
  <Target Name="CopyToProfile" AfterTargets="Build">
    <MakeDir Directories="$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus" />
    <Copy SourceFiles="$(TargetPath);@(ReferenceCopyLocalPaths)"
          DestinationFolder="$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus"
          SkipUnchangedFiles="true" />
    <!-- Facepunch steam_api64 must not remain: it breaks SteamAPI_Init entry points. -->
    <Delete Files="$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus\steam_api64.dll"
            Condition="Exists('$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus\steam_api64.dll')"
            ContinueOnError="true" />
    <Delete Files="$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus\Facepunch.Steamworks.Win64.dll"
            Condition="Exists('$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus\Facepunch.Steamworks.Win64.dll')"
            ContinueOnError="true" />
    <Warning Text="Close SineusArena.exe to remove obsolete Facepunch steam_api64.dll from the plugin folder."
             Condition="Exists('$(BepInExProfile)\BepInEx\plugins\Fowks-SineusArenaVersus\steam_api64.dll')" />
  </Target>
</Project>
